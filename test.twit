function main() = int {
    new int x = 0
    x++
    print << x

    new int y = 10
    y += 5
    print << y

    if (x > 0) {
        print << "positive"
    } else if (x == 0) {
        print << "zero"
    } else {
        print << "negative"
    }

    for (new int i = 0; i < 5; i++) {
        if (i == 3) {
            break
        }
        print << i
    }

    return 0
}